# ============================================================
# Configuration HyperFix — Agent Gamme (copiez ce fichier en .env)
#   cp .env.example .env
# ============================================================

# --- Base de données PostgreSQL ---
POSTGRES_USER=nao
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=nao

# --- Serveur nao ---
SERVER_PORT=5005
ENABLE_USER_SIGNUP=false

# Secret de session (générez-en un : openssl rand -base64 32)
BETTER_AUTH_SECRET=changez-moi
BETTER_AUTH_URL=http://localhost:5005/

# --- Fournisseur ExperientialLabs (défaut partout depuis 09/2026 : luna + repli deepseek) ---
# Base unique OpenAI-compatible. Testé 10/09/2026 : gpt-5.6-luna gratuit (cost 0.0,
# OK à max_tokens>=4000, vide à 50) ; deepseek-v4-flash gratuit en repli.
EXPERIENTIAL_BASE_URL=https://api.experientiallabs.ai/v1
EXPERIENTIAL_API_KEY=changez-moi
EXPERIENTIAL_CHAT_MODEL=gpt-5.6-luna
EXPERIENTIAL_FALLBACK_MODEL=deepseek-v4-flash

# --- Fournisseurs LLM ---
# Clé API OpenCode Go (abonnement — utilisée par nao via {{ env('OPENCODE_API_KEY') }})
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=changez-moi

# Provider OpenCode Zen (pay-as-you-go — utilisé par gamme-engine via
# OPENCODE_ZEN_BASE_URL/API_KEY, et par nao pour les modèles Muse gratuits)
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_API_KEY=changez-moi

# Provider B.AI (conversations nao par défaut via nao_config.yaml : glm-5.3-flash)
B_AI_BASE_URL=https://api.b.ai/v1
B_AI_API_KEY=changez-moi

# Clé Gemini (optionnelle — utilisée en secours par gamme-engine)
GEMINI_API_KEY=

# --- Bot Telegram (optionnel) ---
# Token du bot (config complète en base : project.telegram_settings)
TELEGRAM_BOT_TOKEN=

# --- Moteur gamme-engine (100% luna défaut, deepseek en repli via code) ---
# Le moteur lit OPENCODE_BASE_URL/API_KEY + GAMME_LLM_MODEL. Pour ExperientialLabs,
# recopiez les valeurs EXPERIENTIAL_* ici (ou pointez OPENCODE_ZEN_* vers experiential,
# car docker-compose mappe OPENCODE_* moteur <- OPENCODE_ZEN_*).
# Exemple prod experiential :
#   OPENCODE_ZEN_BASE_URL=https://api.experientiallabs.ai/v1
#   OPENCODE_ZEN_API_KEY=<votre clé xpl_...>
#   GAMME_LLM_MODEL=gpt-5.6-luna
#   LIBELLER_MODEL=gpt-5.6-luna
#   CLASSIF_MODEL=gpt-5.6-luna
GAMME_LLM_MODEL=gpt-5.6-luna
# Vides = repli auto sur OPENCODE_* moteur (donc experiential si OPENCODE_ZEN_* pointe dessus).
# Pour forcer explicitement, mettez la même clé xpl_... dans les 3 vars.
LIBELLER_BASE_URL=
LIBELLER_API_KEY=
LIBELLER_MODEL=gpt-5.6-luna
CLASSIF_BASE_URL=
CLASSIF_API_KEY=
CLASSIF_MODEL=gpt-5.6-luna
GAMME_MAX_LLM_ARTICLES=40
# Dormants prouvés : 0 vente SM depuis N jours calendaires (défaut 90).
# Changement sans toucher au code : éditer ici puis `docker compose restart gamme-engine`.
DORMANT_JOURS=90
# Seuils d'alertes mouvements : écart (qté UC / valeur FDJ), total cessions du jour (FDJ).
ALERTE_ECART_QTE=50
ALERTE_ECART_VALEUR=10000
ALERTE_CESSION_VALEUR=20000
