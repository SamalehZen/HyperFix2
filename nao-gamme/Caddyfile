# OpenMausBot — personal cloud behind Cloudflare proxy (migré depuis le caddy système)
popo.hypeer.cloud {
	encode gzip
	reverse_proxy host.docker.internal:8800
}

# Gamme Épicerie Salée — nao agent en production
lololo.hypeer.cloud {
	encode zstd gzip
	handle /rapports/* {
		uri strip_prefix /rapports
		root * /rapports
		file_server browse
	}
	handle /etiquettes/* {
		uri strip_prefix /etiquettes
		root * /etiquettes
		file_server browse
	}
	handle /images/* {
		uri strip_prefix /images
		root * /images
		file_server
	}
	handle /mcp* {
		reverse_proxy gamme-engine:8010
	}
	handle /.well-known/oauth-protected-resource* {
		reverse_proxy gamme-engine:8010
	}
	handle /story-data/* {
		reverse_proxy gamme-engine:8010
	}
	handle /story* {
		reverse_proxy dashboard-preview:3000
	}
	handle /healthz {
		reverse_proxy gamme-engine:8010
	}
	handle {
		reverse_proxy nao:5005
	}
}
# OpenBot — momo.hypeer.cloud
momo.hypeer.cloud {
	encode gzip
	reverse_proxy openbot-prod-openbot-1:3001
}
