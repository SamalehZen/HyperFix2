# OpenMausBot — personal cloud behind Cloudflare proxy (migré depuis le caddy système)
popo.hypeer.cloud {
	encode gzip
	reverse_proxy host.docker.internal:8800
}

# Gamme Épicerie Salée — nao agent en production
# ⚠️ PAS d'encode global zstd/gzip: bufferise le SSE /api/agent (analyzing infini) — encode seulement sur assets statiques
lololo.hypeer.cloud {
	handle /rapports/* {
		basicauth {
			sam $2a$14$Y.KTJz00N/WkkPJP3PLMueqJztcqBBPEsKqmt4S0WI4AC32hWLfoK
		}
		uri strip_prefix /rapports
		root * /rapports
		file_server browse
	}
	handle /etiquettes/* {
		basicauth {
			sam $2a$14$Y.KTJz00N/WkkPJP3PLMueqJztcqBBPEsKqmt4S0WI4AC32hWLfoK
		}
		uri strip_prefix /etiquettes
		root * /etiquettes
		file_server browse
	}
	handle /images/* {
		basicauth {
			sam $2a$14$Y.KTJz00N/WkkPJP3PLMueqJztcqBBPEsKqmt4S0WI4AC32hWLfoK
		}
		uri strip_prefix /images
		root * /images
		file_server
	}
	handle /mcp* {
		reverse_proxy gamme-engine:8010
	}
	handle /.well-known/oauth-protected-resource* {
		reverse_proxy gamme-engine:8010
	}
	handle /story-data/* {
		basicauth {
			sam $2a$14$Y.KTJz00N/WkkPJP3PLMueqJztcqBBPEsKqmt4S0WI4AC32hWLfoK
		}
		reverse_proxy gamme-engine:8010
	}
	handle /story {
		redir /story/ 302
	}
	handle /story* {
		basicauth {
			sam $2a$14$Y.KTJz00N/WkkPJP3PLMueqJztcqBBPEsKqmt4S0WI4AC32hWLfoK
		}
		reverse_proxy dashboard-preview:3000
	}
	handle /healthz {
		reverse_proxy gamme-engine:8010
	}
	handle {
		reverse_proxy nao:5005
	}
}
